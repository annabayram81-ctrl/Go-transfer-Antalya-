{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/images/:path*",
      "destination": "/public/images/:path*"
    },
    {
      "source": "/routes/lara",
      "destination": "/route-detail"
    },
    {
      "source": "/routes/belek",
      "destination": "/route-detail"
    },
    {
      "source": "/routes/alanya",
      "destination": "/route-detail"
    },
    {
      "source": "/routes/side",
      "destination": "/route-detail"
    },
    {
      "source": "/routes/konyaalti",
      "destination": "/route-detail"
    },
    {
      "source": "/routes/:slug",
      "destination": "/route-placeholder"
    },
    {
      "source": "/places/:slug",
      "destination": "/place-placeholder"
    }
  ]
}
